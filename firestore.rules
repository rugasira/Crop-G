rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Make sure users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow access to all documents within the user's history subcollection
      match /history/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
